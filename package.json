{
  "name": "online-banking-system",
  "version": "1.0.0",
  "description": "Full-Stack Online Banking System - SE Mini Project",
  "main": "server/src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "build:client": "npm --prefix client run build",
    "build": "npm run install:all && npm run build:client",
    "start": "node server/src/index.js",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "seed": "npm --prefix server run seed",
    "test": "node test_system.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
